{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Copy to wrangler.staging.jsonc, set the approved D1 ID, and follow docs/staging.md.
  // The template has no route and both default endpoints are disabled.
  "name": "ocp-v01-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "run_worker_first": ["/api/*", "/mcp", "/.well-known/*"] },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "1101", "simple": { "limit": 240, "period": 60 } },
    { "name": "PARTICIPANT_LIMIT", "namespace_id": "1102", "simple": { "limit": 120, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ocp-v01-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OCP_PUBLIC_ORIGIN": "https://ocp-staging.example.com",
    "OAUTH_ISSUER": "https://ocp-staging.example.auth0.com/",
    "OAUTH_JWKS_URL": "https://ocp-staging.example.auth0.com/.well-known/jwks.json"
  }
}
