{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ocp-v01",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "run_worker_first": ["/api/*", "/mcp", "/.well-known/*"] },
  "observability": { "enabled": true, "logs": { "invocation_logs": false }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ocp-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
